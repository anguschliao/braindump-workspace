NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3000
# AI stays disabled until you explicitly approve API spending and set these.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# MCP remains disabled until OAuth resource binding and account compatibility are tested.
MCP_ENABLED=false
MCP_RESOURCE=https://your-domain.example/api/mcp
# Supabase OAuth JWT audience must contain MCP_RESOURCE, in addition to authenticated.
# Configure resource-aware issuance with your identity provider before enabling.
